# Copy this file to .env and fill in your real values.
# .env is gitignored — never commit real tokens.

# Local Strapi instance — read by scripts/review-case-studies.js,
# scripts/publish-case-studies.js, and scripts/seed-case-studies-manifest.js.
# NOT read by scripts/build-case-studies.js (the site build), which only
# reads data/case-studies-manifest.json and has no Strapi/network access.
STRAPI_URL=http://localhost:1337
STRAPI_API_TOKEN=

# Production Strapi instance (fill in later, when ready)
# STRAPI_PROD_URL=
# STRAPI_PROD_API_TOKEN=
